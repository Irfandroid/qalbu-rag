# Server-only credentials. Keep real values only in untracked .env or host secret store.
APP_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy JWT fallback only. Prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v5-text-small
EMBEDDING_DIMENSIONS=768
# Optional: required only when the Kemenag manifest has missing verses.
KEMENAG_API_BASE_URL=https://quran-api.lpmqkemenag.id/alquran/data
KEMENAG_USERNAME=
KEMENAG_PASSWORD=
KEMENAG_TOKEN=
MIN_RETRIEVAL_SCORE=0.32
TOP_K_RETRIEVAL=15
RETRIEVAL_PARENT_K=4
MAX_CONTEXT_TOKENS=1800
REQUEST_TIMEOUT_SECONDS=30
CHAT_RATE_LIMIT_PER_MINUTE=10
RAG_CACHE_VERSION=qalbu-mvp-v1
ALLOWED_ORIGINS=http://localhost:8000
QALBU_PROFILE=local
# Must be verified before public release. Do not invent a hotline number.
CRISIS_LINE=
CRISIS_LINE_LABEL=Layanan darurat setempat
LOG_LEVEL=INFO
