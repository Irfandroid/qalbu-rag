# Server-only credentials. Keep real values only in untracked .env or host secret store.
GROQ_API_KEY=
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
# 8 GB CPU profile. Smaller context saves RAM; brief residency avoids reloads.
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=5m
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy JWT fallback only. Prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Quran Foundation Content API. New apps use prelive first; production needs approval.
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=prelive

GROQ_MODEL=openai/gpt-oss-20b
EMBEDDING_PROVIDER=local_e5
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSIONS=768
MIN_RETRIEVAL_SCORE=0.55
RETRIEVAL_CANDIDATE_K=12
RETRIEVAL_PARENT_K=2
CHAT_RATE_LIMIT_PER_MINUTE=10
RAG_CACHE_VERSION=sample-v1
ALLOWED_ORIGINS=http://localhost:8000
QALBU_PROFILE=local
# Must be verified before public release. Do not invent a hotline number.
CRISIS_LINE=
CRISIS_LINE_LABEL=Layanan darurat setempat
MAX_QUEUE=3
LOG_LEVEL=INFO
