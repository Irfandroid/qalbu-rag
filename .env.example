# Server-only credentials. Keep real values only in untracked .env or host secret store.
APP_ENV=development
# Local PostgreSQL. Compose overrides the host to the `postgres` service.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://qalbu:change-me@localhost:5432/qalbu
# Ollama runs locally; compose overrides the host to the `ollama` service.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBEDDING_MODEL=embeddinggemma
# 4 GB VPS: keep the context window small to leave room for both models.
OLLAMA_NUM_CTX=2048
QALBU_CORPUS=qalbu-kemenag-v1
EMBEDDING_DIMENSIONS=768
# Optional: required only when the Kemenag manifest has missing verses.
KEMENAG_API_BASE_URL=https://quran-api.lpmqkemenag.id/alquran/data
KEMENAG_USERNAME=
KEMENAG_PASSWORD=
KEMENAG_TOKEN=
MIN_RETRIEVAL_SCORE=0.32
TOP_K_RETRIEVAL=15
RETRIEVAL_PARENT_K=4
MAX_CONTEXT_TOKENS=1800
REQUEST_TIMEOUT_SECONDS=240
CHAT_RATE_LIMIT_PER_MINUTE=10
RAG_CACHE_VERSION=qalbu-mvp-v1
# Public port served by lighttpd. Use 80 on the VPS.
QALBU_HTTP_PORT=8000
ALLOWED_ORIGINS=http://localhost:8000
QALBU_PROFILE=local
# Must be verified before public release. Do not invent a hotline number.
CRISIS_LINE=
CRISIS_LINE_LABEL=Layanan darurat setempat
LOG_LEVEL=INFO
